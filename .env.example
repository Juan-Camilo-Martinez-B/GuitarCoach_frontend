# GuitarCoach frontend — variables de entorno.
# La URL de la API. No incluir secretos.
# En Vercel este valor se escribe en el JavaScript al construir.
# Es una variable normal, no un secreto. Cámbiala y vuelve a desplegar.
# El cliente quita una barra final si la URL la trae.
VITE_API_URL=http://localhost:8000
